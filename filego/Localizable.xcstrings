    "me.deleteAccount.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your name is released, every receiving address and download link stops working at once, and files still waiting on the server are deleted. Files already saved on this iPhone stay here. If you register again, the included features are turned back on automatically. This can't be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的名字会被释放，所有收件地址和下载链接立即失效，服务器上尚未取走的文件会被删除。已经保存到这台 iPhone 上的文件会保留。重新注册后，已包含的功能会自动重新开通。此操作无法撤销。"
          }
        }
      }
    },
