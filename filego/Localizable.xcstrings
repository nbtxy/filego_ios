    "share.delete.message.ended" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The record is removed from this list. Its path becomes free, so a later link can use that address — anyone still holding this one would reach a different file."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这条记录会从列表里消失。它的路径会被释放，以后的链接可能会用上同一个地址 —— 还拿着旧链接的人会打开另一个文件。"
          }
        }
      }
    },
    "share.delete.message.live" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The link stops working immediately and the file is deleted from the server. Its path becomes free, so a later link can use that address — anyone still holding this one would reach a different file. Copies people already downloaded remain with them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "链接当场失效，文件从服务器上删除。它的路径会被释放，以后的链接可能会用上同一个地址 —— 还拿着旧链接的人会打开另一个文件。别人已经下载到手的副本不会消失。"
          }
        }
      }
    },
