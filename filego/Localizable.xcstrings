    "name.change.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every address and share link on this device moves to the new name at once. The old addresses stop working immediately, cutting off anyone holding them, and the old name goes straight back into the pool for someone else to take."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备上所有地址和分享链接会立刻搬到新名字下。旧地址马上失效，拿着旧链接的人会断掉，旧名字当场回到公共池，随时可能被别人取走。"
          }
        }
      }
    },
