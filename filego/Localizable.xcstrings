    "inbox.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address, its records, and anything still waiting in the relay go with it. Files already on this iPhone stay. The path becomes free for a new link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址、它的传输记录、还停在中转站没下载的文件会一起消失。已经落到手机上的文件留着。路径会释放出来给新链接用。"
          }
        }
      }
    },
