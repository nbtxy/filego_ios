    "account.delete.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your files, everything in the trash and your account details will be permanently deleted. This can't be undone."
          }
        },
