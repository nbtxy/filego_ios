        }
      }
    },
    "login.error.noAppleAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to an Apple Account in Settings first, then try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在系统「设置 › Apple 账户」中登录 Apple 账户，再使用此方式登录"
          }
        }
      }
    },
    "login.error.noToken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
